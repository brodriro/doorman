#!/bin/bash

# Scans the LAN behind the active route and prints one JSON snapshot of the
# devices on it. Unprivileged: an optional ping sweep makes the kernel resolve
# ARP for every host, then the neighbor table is read back. mDNS supplies names.
#
# Usage: doorman-scan [--no-sweep] [--iface <dev>]
#
# Test hook: WM_FIXTURE_DIR=<dir> replaces every live command with files from
# <dir> (route.txt, addr.json, neigh.json, mac.txt, avahi.txt, wifi.txt) and
# WM_NOW fixes the timestamp. See tests/.

set -euo pipefail

PROBE=1.1.1.1
MAX_DEVICES=256
SWEEP_PARALLEL=64
SWEEP_TIMEOUT=8
MDNS_TIMEOUT=3

sweep=1
iface=""

fail() {
  echo "doorman-scan: $*" >&2
  exit 1
}

while (( $# > 0 )); do
  case "$1" in
    --no-sweep) sweep=0; shift ;;
    --iface) iface="${2:-}"; [[ -n $iface ]] || fail "--iface requires a device"; shift 2 ;;
    -h | --help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

fixture() { [[ -n ${WM_FIXTURE_DIR:-} ]]; }

read_route() {
  if fixture; then cat "$WM_FIXTURE_DIR/route.txt"; else ip route get "$PROBE" 2>/dev/null || true; fi
}

read_addr() {
  if fixture; then cat "$WM_FIXTURE_DIR/addr.json"; else ip -j -4 addr show dev "$1"; fi
}

read_neigh() {
  if fixture; then cat "$WM_FIXTURE_DIR/neigh.json"; else ip -j -4 neigh show dev "$1"; fi
}

read_self_mac() {
  if fixture; then cat "$WM_FIXTURE_DIR/mac.txt"; else cat "/sys/class/net/$1/address"; fi
}

is_wireless() {
  if fixture; then [[ -f $WM_FIXTURE_DIR/wifi.txt ]]; else [[ -d /sys/class/net/$1/wireless ]]; fi
}

# Prints "ssid<TAB>bssid" for the associated access point.
read_wifi() {
  if fixture; then cat "$WM_FIXTURE_DIR/wifi.txt"; return; fi
  nmcli -t -e no -f IN-USE,SSID,BSSID dev wifi list ifname "$1" --rescan no 2>/dev/null |
    awk -F: '$1 == "*" { bssid = $3; for (i = 4; i <= NF; i++) bssid = bssid ":" $i; printf "%s\t%s\n", $2, bssid; exit }'
}

# Parsable avahi-browse output; resolved lines carry hostname and address.
read_mdns() {
  if fixture; then cat "$WM_FIXTURE_DIR/avahi.txt" 2>/dev/null || true; return; fi
  command -v avahi-browse >/dev/null || return 0
  timeout "$MDNS_TIMEOUT" avahi-browse -atrpk 2>/dev/null || true
}

ip_to_int() {
  local a b c d
  IFS=. read -r a b c d <<<"$1"
  echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}

int_to_ip() {
  local n=$1
  echo "$(( (n >> 24) & 255 )).$(( (n >> 16) & 255 )).$(( (n >> 8) & 255 )).$(( n & 255 ))"
}

route=$(read_route)
[[ -n $iface ]] || iface=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' <<<"$route")
[[ -n $iface ]] || fail "no active network route"
[[ $iface =~ ^[A-Za-z0-9._-]{1,15}$ ]] || fail "invalid interface name"
gateway=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }' <<<"$route")

addr_json=$(read_addr "$iface")
address=$(jq -r '[.[].addr_info[]? | select(.family == "inet")][0].local // empty' <<<"$addr_json")
prefix=$(jq -r '[.[].addr_info[]? | select(.family == "inet")][0].prefixlen // empty' <<<"$addr_json")
[[ -n $address && -n $prefix ]] || fail "$iface has no IPv4 address"

# Never sweep more than a /24: larger networks are clamped to our own /24.
sweep_prefix=$prefix
(( sweep_prefix >= 24 )) || sweep_prefix=24
self_int=$(ip_to_int "$address")
mask=$(( (0xFFFFFFFF << (32 - sweep_prefix)) & 0xFFFFFFFF ))
net_int=$(( self_int & mask ))
broadcast_int=$(( net_int | (~mask & 0xFFFFFFFF) ))
subnet="$(int_to_ip "$net_int")/$sweep_prefix"

scanned=0
if (( sweep )) && ! fixture; then
  hosts=()
  for (( h = net_int + 1; h < broadcast_int; h++ )); do
    (( h == self_int )) || hosts+=("$(int_to_ip "$h")")
  done
  scanned=${#hosts[@]}
  printf '%s\n' "${hosts[@]}" |
    timeout "$SWEEP_TIMEOUT" xargs -P "$SWEEP_PARALLEL" -I{} ping -c1 -W1 -n -q {} >/dev/null 2>&1 || true
fi

ssid=""
bssid=""
wireless=false
if is_wireless "$iface"; then
  wireless=true
  IFS=$'\t' read -r ssid bssid < <(read_wifi "$iface") || true
fi

self_mac=$(read_self_mac "$iface" | tr -d '[:space:]')
neigh_json=$(read_neigh "$iface")
mdns=$(read_mdns | awk -F';' '$1 == "=" && $3 == "IPv4" { print $8 "\t" $7 }' | sort -u)

jq -n \
  --argjson neigh "$neigh_json" \
  --arg mdns "$mdns" \
  --arg iface "$iface" \
  --arg address "$address" \
  --argjson prefix "$prefix" \
  --arg subnet "$subnet" \
  --arg gateway "$gateway" \
  --arg selfMac "$self_mac" \
  --argjson wireless "$wireless" \
  --arg ssid "$ssid" \
  --arg bssid "$bssid" \
  --argjson sweep "$sweep" \
  --argjson scanned "$scanned" \
  --argjson max "$MAX_DEVICES" \
  --argjson now "${WM_NOW:-$(date +%s)}" '
  def mac_ok: test("^[0-9a-f]{2}(:[0-9a-f]{2}){5}$");
  def ip_ok: test("^[0-9]{1,3}(\\.[0-9]{1,3}){3}$");
  # Names come from the network and are untrusted: keep a conservative
  # character set and a bounded length.
  def clean_name:
    sub("\\.local\\.?$"; "")
    | gsub("[^A-Za-z0-9 ._()-]"; "")
    | .[0:64];
  # Locally administered bit set: a randomized (private) MAC.
  def random_mac: (.[1:2] | test("[26ae]"));

  ($mdns | split("\n") | map(select(length > 0) | split("\t") | select(.[0] | ip_ok) | {key: .[0], value: (.[1] | clean_name)})
    | map(select(.value != "")) | from_entries) as $names

  | ($selfMac | ascii_downcase) as $self
  | [ $neigh[]
      | select(.dst? and (.dst | ip_ok) and .lladdr?)
      | select((.state // []) | any(. == "FAILED" or . == "INCOMPLETE") | not)
      | {ip: .dst, mac: (.lladdr | ascii_downcase), state: ((.state // ["UNKNOWN"])[0])}
      | select(.mac | mac_ok)
    ]
  | (if ($self | mac_ok) then . + [{ip: $address, mac: $self, state: "SELF"}] else . end)
  | unique_by(.mac)
  | sort_by(.ip | split(".") | map(tonumber))
  | .[0:$max]
  | map(. + {
      name: ($names[.ip] // null),
      nameSource: (if $names[.ip] then "mdns" else null end),
      randomMac: (.mac | random_mac),
      isGateway: (.ip == $gateway),
      isSelf: (.mac == $self)
    }) as $devices

  | ($devices | map(select(.isGateway)) | .[0].mac // null) as $gwMac
  | {
      schema: 1,
      ts: $now,
      network: {
        id: (if $gwMac then ($gwMac | gsub(":"; "")) else null end),
        iface: $iface,
        wireless: $wireless,
        ssid: (if $ssid == "" then null else ($ssid | .[0:64]) end),
        bssid: (if ($bssid | ascii_downcase | mac_ok) then ($bssid | ascii_downcase) else null end),
        address: $address,
        prefix: $prefix,
        subnet: $subnet,
        gateway: (if $gateway == "" then null else $gateway end),
        gatewayMac: $gwMac
      },
      sweep: {enabled: ($sweep == 1), scanned: $scanned},
      devices: $devices
    }
'
